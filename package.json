{
  "name": "avihtech",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply avihtech-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply avihtech-db --remote",
    "db:seed": "wrangler d1 execute avihtech-db --local --file=seed.sql"
  },
  "devDependencies": {
    "wrangler": "4.86.0"
  }
}
